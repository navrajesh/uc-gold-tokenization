{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "backend": {
      "root": "backend",
      "framework": "express",
      "entrypoint": "src/server.ts",
      "outputDirectory": "."
    },
    "frontend": {
      "root": "frontend",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/health",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "backend"
      }
    },
    {
      "source": "/about",
      "destination": {
        "service": "frontend",
        "path": "/"
      },
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/"
        }
      ]
    },
    {
      "source": "/admin",
      "destination": {
        "service": "frontend",
        "path": "/"
      },
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/"
        }
      ]
    },
    {
      "source": "/investor",
      "destination": {
        "service": "frontend",
        "path": "/"
      },
      "transforms": [
        {
          "type": "request.path",
          "op": "set",
          "args": "/"
        }
      ]
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "frontend"
      }
    }
  ]
}
