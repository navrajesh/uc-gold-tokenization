{
  "name": "gold-tokenization-backend",
  "version": "1.0.0",
  "description": "Gold Tokenization Platform – Express API",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "db:generate": "drizzle-kit generate",
    "generate-types": "node -e \"const {cpSync}=require('fs');cpSync('../typechain-types','generated/typechain-types',{recursive:true});console.log('Types copied.')\""
  },
  "dependencies": {
    "@libsql/client": "^0.14.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "drizzle-orm": "^0.38.4",
    "ethers": "^6.9.0",
    "express": "^4.18.2",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "drizzle-kit": "^0.30.4",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
