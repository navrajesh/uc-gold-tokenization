# Complete hosted-demo environment template.
# Copy this file to .env for the local deployment CLI. Import the "Vercel
# runtime" section into Vercel Production. Never commit the populated .env.

# ── Vercel runtime ───────────────────────────────────────────────────────────
# Vercel supplies PORT automatically. Uncomment only for a local backend.
# PORT=3001
NODE_ENV=production
FRONTEND_URL=https://replace-with-your-vercel-domain.vercel.app

# Backend blockchain connection (Polygon Amoy).
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/replace-with-your-key
CHAIN_ID=80002

# Dedicated TESTNET-ONLY deployment wallets. Never use personal/mainnet keys.
DEPLOYER_PRIVATE_KEY=0xreplace-with-testnet-deployer-private-key
CUSTODIAN_PRIVATE_KEY=0xreplace-with-testnet-custodian-private-key

# Persistent hosted database.
TURSO_DATABASE_URL=libsql://replace-with-your-database.turso.io
TURSO_AUTH_TOKEN=replace-with-your-turso-auth-token

# Shared by the Vercel backend and the trusted local deployment CLI.
DEMO_SEED_TOKEN=replace-with-a-long-random-value

# ── Local Hardhat deployment CLI ─────────────────────────────────────────────
# Use the same Alchemy URL as RPC_URL above.
AMOY_RPC_URL=https://polygon-amoy.g.alchemy.com/v2/replace-with-your-key

# Demo investor wallet addresses. These do not need to expose private keys here.
DEMO_INVESTOR_1_ADDRESS=0xreplace-with-first-investor-address
DEMO_INVESTOR_2_ADDRESS=0xreplace-with-second-investor-address

# Hosted backend origin used by deployment scripts to register seeded data.
DEMO_API_URL=https://replace-with-your-vercel-domain.vercel.app
